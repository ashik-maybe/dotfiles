# Text files use LF line endings.
* text=auto eol=lf

# Dotfiles stay LF on every platform.
*.fish text eol=lf
*.conf text eol=lf
*.toml text eol=lf
*.kdl  text eol=lf
*.json text eol=lf
*.ini  text eol=lf

# Binary files: do not convert line endings.
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
