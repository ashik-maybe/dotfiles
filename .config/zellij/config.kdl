// Zellij — Catppuccin Macchiato theme, borderless panes, detach on close.

// Appearance: theme, no pane frames, simplified UI to avoid rendering glitches.
theme "catppuccin-macchiato"
pane_frames false
simplified_ui true

// Behavior: detach (do not kill panes) when the session is force-closed.
on_force_close "detach"

// Interaction: mouse on, copy on select, system clipboard.
// Clipboard backend: uncomment one line for your display server if copy fails.
// copy_command "wl-copy"                // Wayland
// copy_command "xclip -selection clipboard" // X11
// copy_command "pbcopy"               // macOS
mouse_mode true
copy_on_select true
copy_clipboard "system"

// Performance: 10000 lines of scrollback per pane.
scroll_buffer_size 10000

// Startup: no tips, no release notes. Focus follows the mouse.
show_startup_tips false
show_release_notes false
focus_follows_mouse true
