// Zellij — defaults with auto light/dark theme.
// Plain `zellij` uses the default layout. `zj` starts dev-layout.

theme_dark "eye-care-night"
theme_light "eye-care-day"

show_startup_tips false
mouse_mode true
copy_on_select true
copy_clipboard "system"
scroll_buffer_size 10000
on_force_close "detach"

// Optional floating Lazygit.
keybinds {
    normal {
        bind "Ctrl g" {
            Run "lazygit" {
                floating true
            }
        }
    }
}
