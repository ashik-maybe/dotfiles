// Zellij dev-layout — shell-first dev workspace, 2 tabs, 5 panes.
// Start with `zj`. Plain `zellij` starts the default layout, not this one.
// Layout name is `dev-layout`. Old name `dev-compact` no longer exists.

// Layout map:
// Tab `Develop`: main shell left, git pane top-right, monitor pane bottom-right.
// Tab `Run program`: run pane top, logs pane bottom. Use for servers, tests, watchers.
// Why shell-first: main file is unknown at layout time. You pick editor, tests, builds.
// Why git suspended: lazygit is heavy and needs a git repo. Press Enter to run it.
// Why monitor auto-runs: top is light and always present. Sorted by CPU, 1s refresh.
// Why no cwd: inherit launch directory. Works in any project, no path edits.
// Themes: inherited from config.kdl. Dark Macchiato, light Latte, auto switch.
// Bars: line 1 tab-bar for navigation, line 2 status-bar for mode and tips. No overlap.
// Requirements: lazygit for git pane and Alt g. Top from procps. Eza for Alt 3.

// Keyboard shortcuts. Prefix is Ctrl g, unless stated otherwise.
// Quit session: Ctrl q. Detach and keep running: Ctrl o, then d. Reattach: zellij attach.
// Close pane: Ctrl g, p, x. Close tab: Ctrl g, t, x.
// Switch pane: Alt h, Alt j, Alt k, Alt l. Switch tab: Ctrl g, t, l/h or Ctrl g, t, 1/2.
// New pane: Alt n. Toggle floating panes: Alt f. Fullscreen pane: Ctrl g, p, f.
// Resize pane: Ctrl n, then h/j/k/l. Scroll pane: Ctrl s, then j/k.
// Layout shortcuts: Alt 1 git status, Alt 2 git diff, Alt 3 eza -l, Alt g lazygit, Alt m top.
// Troubleshooting: layout not found means wrong name, use `zj`. Session resurrects after quit by default.

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Develop" focus=true split_direction="horizontal" {
        pane name="Edit code" focus=true size="65%"
        pane split_direction="vertical" size="35%" {
            pane name="Check git status" command="lazygit" start_suspended=true size="55%"
            pane name="Watch CPU use" command="top" size="45%" {
                args "-o" "%CPU" "-d" "1"
            }
        }
    }

    tab name="Run program" split_direction="vertical" {
        pane name="Run program" size="75%"
        pane name="Read program logs" size="25%"
    }
}

// Keybinds: layout-local shortcuts. Active only when session starts with this layout.
keybinds {
    shared {
        bind "Alt 1" { Run "git" "status"; }
        bind "Alt 2" { Run "git" "diff"; }
        bind "Alt 3" { Run "eza" "-l"; }
        bind "Alt g" { Run "lazygit"; }
        bind "Alt m" { Run "top" "-o" "%CPU" "-d" "1"; }
    }
}
