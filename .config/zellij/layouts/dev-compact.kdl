// Zellij dev-compact layout — shell-first dev workspace, 2 tabs, 4 panes.
// `zj` starts this layout. Plain `zellij` starts the full default layout.
// Main pane gets focus. Git pane starts suspended: press Enter to run lazygit.
// Monitor pane auto-runs top sorted by CPU. Top ships with procps, no extra install.
// LazyGit is required for the git pane and Alt g keybind. Install it separately.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }

    tab name="dev" focus=true split_direction="horizontal" {
        pane name="editor" focus=true size="65%"
        pane split_direction="vertical" size="35%" {
            pane name="git" command="lazygit" start_suspended=true size="55%"
            pane name="monitor" command="top" size="45%" {
                args "-o" "%CPU" "-d" "1"
            }
        }
    }

    tab name="run" split_direction="vertical" {
        pane name="run" size="75%"
        pane name="logs" size="25%"
    }
}

// Keybinds: layout-local shortcuts. Active only when session starts with this layout.
keybinds {
    shared {
        bind "Alt 1" { Run "git" "status"; }
        bind "Alt 2" { Run "git" "diff"; }
        bind "Alt 3" { Run "eza" "-l"; }
        bind "Alt g" { Run "lazygit"; }
        bind "Alt m" { Run "top" "-o" "%CPU" "-d" "1"; }
    }
}
