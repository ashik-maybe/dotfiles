# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#fbf1c7"
# bg0

# Main text color
theme[main_fg]="#654735"
# fg0

# Title color for boxes
theme[title]="#654735"
# fg0

# Highlight color for keyboard shortcuts
theme[hi_fg]="#c14a4a"
# red

# Background color of selected item in processes box
theme[selected_bg]="#b47109"
# yellow

# Foreground color of selected item in processes box
theme[selected_fg]="#fbf1c7"
# bg0

# Color of inactive/disabled text
theme[inactive_fg]="#a89984"
# bg4

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#a89984"
# bg4

# Background color of the percentage meters
theme[meter_bg]="#a89984"
# bg4

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#6c782e"
# green

# Cpu box outline color
theme[cpu_box]="#a89984"
# bg4

# Memory/disks box outline color
theme[mem_box]="#a89984"
# bg4

# Net up/down box outline color
theme[net_box]="#a89984"
# bg4

# Processes box outline color
theme[proc_box]="#a89984"
# bg4

# Box divider line and small boxes line color
theme[div_line]="#a89984"
# bg4

# Temperature graph colors
theme[temp_start]="#45707a"
# blue
theme[temp_mid]="#c35e0a"
# orange
theme[temp_end]="#c14a4a"
# red

# CPU graph colors
theme[cpu_start]="#6c782e"
# green
theme[cpu_mid]="#b47109"
# yellow
theme[cpu_end]="#c14a4a"
# red

# Mem/Disk free meter
# all green
theme[free_start]="#6c782e"
theme[free_mid]="#6c782e"
theme[free_end]="#6c782e"

# Mem/Disk cached meter
# all purple
theme[cached_start]="#945e80"
theme[cached_mid]="#945e80"
theme[cached_end]="#945e80"

# Mem/Disk available meter
# all aqua
theme[available_start]="#4c7a5d"
theme[available_mid]="#4c7a5d"
theme[available_end]="#4c7a5d"

# Mem/Disk used meter
# all red
theme[used_start]="#c14a4a"
theme[used_mid]="#c14a4a"
theme[used_end]="#c14a4a"

# Download graph colors
# blue for start, aqua for the rest
theme[download_start]="#45707a"
theme[download_mid]="#4c7a5d"
theme[download_end]="#4c7a5d"

# Upload graph colors
theme[upload_start]="#c14a4a"
# red for start
theme[upload_mid]="#c14a4a"
# red for mid and end
theme[upload_end]="#c14a4a"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#45707a"
# blue
theme[process_mid]="#4c7a5d"
# aqua for mid and end
theme[process_end]="#4c7a5d"
