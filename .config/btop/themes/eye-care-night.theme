# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#1d2021"
# bg0

# Main text color
theme[main_fg]="#d5dae2"
# fg0

# Title color for boxes
theme[title]="#d5dae2"
# fg0

# Highlight color for keyboard shortcuts
theme[hi_fg]="#e09853"
# yellow

# Background color of selected item in processes box
theme[selected_bg]="#665c54"
# muted

# Foreground color of selected item in processes box
theme[selected_fg]="#d5dae2"
# fg0

# Color of inactive/disabled text
theme[inactive_fg]="#a89984"
# muted

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#a89984"
# muted

# Background color of the percentage meters
theme[meter_bg]="#a89984"
# muted

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#a9b665"
# green

# Cpu box outline color
theme[cpu_box]="#7daea3"
# blue

# Memory/disks box outline color
theme[mem_box]="#a9b665"
# green

# Net up/down box outline color
theme[net_box]="#89b482"
# aqua

# Processes box outline color
theme[proc_box]="#d3869b"
# purple

# Box divider line and small boxes line color
theme[div_line]="#7c6f64"
# bg4

# Temperature graph colors
theme[temp_start]="#7daea3"
# blue
theme[temp_mid]="#e78a4e"
# orange
theme[temp_end]="#ea6962"
# red

# CPU graph colors
theme[cpu_start]="#a9b665"
# green
theme[cpu_mid]="#e09853"
# yellow
theme[cpu_end]="#ea6962"
# red

# Mem/Disk free meter
# all green
theme[free_start]="#a9b665"
theme[free_mid]="#a9b665"
theme[free_end]="#a9b665"

# Mem/Disk cached meter
# all purple
theme[cached_start]="#d3869b"
theme[cached_mid]="#d3869b"
theme[cached_end]="#d3869b"

# Mem/Disk available meter
# all aqua
theme[available_start]="#89b482"
theme[available_mid]="#89b482"
theme[available_end]="#89b482"

# Mem/Disk used meter
# all red
theme[used_start]="#ea6962"
theme[used_mid]="#ea6962"
theme[used_end]="#ea6962"

# Download graph colors
# blue for start, aqua for the rest
theme[download_start]="#7daea3"
theme[download_mid]="#89b482"
theme[download_end]="#89b482"

# Upload graph colors
theme[upload_start]="#ea6962"
# red for start
theme[upload_mid]="#ea6962"
# red for mid and end
theme[upload_end]="#ea6962"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#7daea3"
# blue
theme[process_mid]="#89b482"
# aqua for mid and end
theme[process_end]="#89b482"
