# Catppuccin Latte by default. For Macchiato, swap to:
#   source ./themes/catppuccin-macchiato.config
source ./themes/catppuccin-latte.config

# Recolor PDF pages onto the Catppuccin surface. Toggle with toggle_custom_color.
startup_commands toggle_custom_color

# Reading behaviour
should_launch_new_window 1
fit_to_page_width_ratio 0.75
ruler_mode 1
ruler_padding 1.0
ruler_x_padding 5.0
wheel_zoom_on_cursor 1
sort_bookmarks_by_location 1
collapsed_toc 0
check_for_updates_on_startup 0
