# User keybinding overrides for Catppuccin themes.
# Format: command <key>
# Defaults live in sioyek's keys.config. Entries here are added on top, and
# binding an already-used key replaces the default binding for that key.
#
# Beginner-friendly additions:
#   arrows scroll, Ctrl+= / Ctrl+- zoom, Ctrl+0 fit width,
#   F3 / Shift+F3 next / previous match, Ctrl+G go to page,
#   Ctrl+O native open dialog, Ctrl+Shift+T table of contents,
#   Ctrl+Shift+P command palette, Ctrl+R toggle page recoloring.

# Arrow keys scroll the page (Up/Down were unbound by default).
move_up <up>
move_down <down>

# Fix sioyek's inverted horizontal arrows: Right shows content to the right.
move_left <left>
move_right <right>

# Zoom, browser-style.
zoom_in <C-=>
zoom_out <C-->
fit_to_page_width <C-0>

# Search results.
next_item <f3>
previous_item <S-f3>

# Go to a page number.
goto_page_with_page_number <C-g>

# Document end (Ctrl+Home already goes to the start).
goto_end <C-<end>>

# Native file dialog on Ctrl+O. The embedded browser stays on Ctrl+Shift+O.
open_document <C-o>

# Table of contents (Ctrl+T is already "new window").
goto_toc <C-S-t>

# Command palette.
command <C-S-p>

# Toggle Catppuccin page recoloring (same key as zathura's recolor toggle).
toggle_custom_color <C-r>
