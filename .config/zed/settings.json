// Zed — user settings.
{
  // Note: This is the user (global) settings file, stowed to ~/.config/zed/settings.json.
  // Keys like theme, telemetry, diagnostics, agent, session are global-only.
  // Project files at .zed/settings.json use the project schema; warnings there are false positives.
  // Do not copy this file into a project's .zed/ folder.
  // 🎨 Theme
  "cli_default_open_behavior": "existing_window",
  "theme": {
    "mode": "system",
    "light": "Eye Care Day",
    "dark": "Eye Care Night",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_family": ".ZedSans",
  "ui_font_size": 15,
  "ui_font_weight": 500,

  // 🧩 Extensions
  // Auto-install language and tool extensions. Keeps the setup portable.
  "auto_install_extensions": {
    "csv": true,
    "dockerfile": true,
    "env": true,
    "git-firefly": true,
    "graphql": true,
    "html": true,
    "make": true,
    "sql": true,
    "toml": true,
    "yaml": true,
  },

  // ✍️ Editor
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_fallbacks": [".ZedMono", "Apple Color Emoji", "Noto Color Emoji", "Segoe UI Emoji"],
  "buffer_font_size": 16,
  "buffer_font_weight": 500,
  "buffer_line_height": "comfortable",
  "buffer_font_features": {
    "calt": true,
    "liga": true,
  },
  "cursor_shape": "bar",
  "cursor_blink": true,
  "current_line_highlight": "line",
  "selection_highlight": true,
  "rounded_selection": true,
  "unnecessary_code_fade": 0.2,

  // 📏 Indentation and wrapping
  "preferred_line_length": 100,
  "soft_wrap": "editor_width",
  "show_wrap_guides": true,
  "wrap_guides": [80, 120],
  "show_whitespaces": "selection",
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
    "active_line_width": 2,
  },

  // 🧭 Gutter and scrolling
  "gutter": {
    "line_numbers": true,
    "folds": true,
    "breakpoints": true,
    "runnables": true,
    "min_line_number_digits": 2,
  },
  "relative_line_numbers": "disabled",
  "scroll_beyond_last_line": "off",
  "horizontal_scroll_margin": 5,
  "vertical_scroll_margin": 3,
  "scroll_sensitivity": 1.2,
  "fast_scroll_sensitivity": 4.8,
  "hide_mouse": "on_typing_and_action",
  "middle_click_paste": true,
  "drag_and_drop_selection": {
    "enabled": true,
    "delay": 300,
  },
  "minimap": {
    "show": "never",
  },
  "scrollbar": {
    "show": "auto",
    "git_diff": true,
    "diagnostics": "error",
  },

  // 💾 Save and editing
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "auto_indent": "syntax_aware",
  "auto_indent_on_paste": true,
  "use_autoclose": true,
  "use_auto_surround": true,
  "linked_edits": true,
  "extend_comment_on_newline": true,

  // 🗂️ Tabs and layout
  "max_tabs": 15,
  "active_pane_modifiers": {
    "border_size": 1.0,
    "inactive_opacity": 1.0,
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": true,
    "show_tab_bar_buttons": true,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_close_button": "hover",
    "activate_on_close": "history",
    "show_diagnostics": "errors",
  },
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_project_panel": true,
    "enable_preview_from_file_finder": false,
    "enable_preview_from_multibuffer": true,
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_branch_name": true,
    "show_project_items": false,
    "show_user_picture": false,
    "show_menus": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "code_actions": false,
    "agent_review": false,
  },
  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": true,
    "line_endings_button": false,
  },
  "project_panel": {
    "folder_indicator": "icon",
    "button": true,
    "dock": "left",
    "default_width": 260,
    "file_icons": true,
    "git_status": true,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
    "hide_root": false,
    "hide_hidden": false,
    "entry_spacing": "comfortable",
    "sort_mode": "directories_first",
    "show_diagnostics": "all",
    "scrollbar": {
      "show": "auto",
    },
    "indent_guides": {
      "show": "always",
    },
  },
  "outline_panel": {
    "dock": "left",
  },

  // 🔀 Git
  "git": {
    "git_gutter": "tracked_files",
    "gutter_style": "detailed",
    "hunk_style": "staged_hollow",
    "fold_placeholder": true,
    "inline_blame": {
      "enabled": true,
      "location": "status_bar",
      "show_commit_summary": true,
      "delay_ms": 2000,
    },
  },
  "git_panel": {
    "button": true,
    "dock": "right",
    "default_width": 320,
    "status_style": "icon",
    "sort_by_path": false,
  },

  // 💻 Terminal
  "terminal": {
    "button": true,
    "dock": "bottom",
    "font_family": "JetBrainsMono Nerd Font Mono",
    "font_fallbacks": [".ZedMono", "Apple Color Emoji", "Noto Color Emoji", "Segoe UI Emoji"],
    "font_size": 16,
    "line_height": "comfortable",
    "cursor_shape": "bar",
    "blinking": "terminal_controlled",
    "copy_on_select": true,
    "keep_selection_on_copy": true,
    "working_directory": "first_project_directory",
    "minimum_contrast": 45,
    "detect_venv": {
      "on": {
        "directories": [],
      },
    },
    "scrollbar": {
      "show": "auto",
    },
    "toolbar": {
      "breadcrumbs": false,
    },
  },
  "load_direnv": "shell_hook",

  // 🔍 Search
  "use_system_path_prompts": false,
  "seed_search_query_from_cursor": "selection",
  "search": {
    "case_sensitive": false,
    "include_ignored": false,
    "regex": false,
    "whole_word": false,
  },

  // 🧠 LSP and autocomplete
  // AI is off. Only LSP provides completion and predictions.
  "disable_ai": true,
  "show_edit_predictions": false,
  "edit_predictions": {
    "provider": "none",
  },

  // Completion
  "show_completions_on_input": true,
  "show_completion_documentation": true,
  "snippet_sort_order": "inline",
  "completion": {
    "lsp_fetch_timeout_ms": 2000,
    "words": {
      "mode": "fallback",
    },
  },

  // Signature help and hover documentation
  "auto_signature_help": false,
  "hover_popover_enabled": true,
  "hover_popover_delay": 400,

  // Inlay hints: parameters and types only, throttled for battery
  "inlay_hints": {
    "enabled": true,
    "edit_debounce_ms": 150,
    "scroll_debounce_ms": 100,
    "show_background": false,
    "show_parameter_hints": true,
    "show_type_hints": true,
    "show_other_hints": false,
  },

  // Syntax highlighting and colors
  "semantic_tokens": "combined",
  "lsp_document_colors": "inlay",
  "lsp_document_links": true,

  // LSP behavior
  "global_lsp_settings": {
    "button": true,
  },

  // Diagnostics
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 300,
      "max_severity": "warning",
      "padding": 2,
    },
  },
  "diagnostics_max_severity": "warning",

  // 🗄️ File exclusions
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/.venv/**",
    "**/venv/**",
    "**/__pycache__/**",
    "**/.mypy_cache/**",
    "**/.pytest_cache/**",
    "**/.bun/**",
    "**/.npm/**",
    "**/.pnpm-store/**",
    "**/.yarn/**",
    "**/.cache/**",
    "**/.turbo/**",
    "**/target/**",
    "**/.zig-cache/**",
    "**/vendor/**",
  ],
  // Per-language settings (latest format). Global keys above stay as fallback.
  "languages": {
    "Python": {
      "formatter": "language_server",
      "format_on_save": "on",
      "tab_size": 4,
      "language_servers": ["pyright", "!ty", "!ruff", "!mypy"],
    },
    "TypeScript": {
      "formatter": "language_server",
      "format_on_save": "on",
      "tab_size": 2,
      "language_servers": ["vtsls", "!typescript-language-server"],
    },
    "JavaScript": {
      "formatter": "language_server",
      "format_on_save": "on",
      "tab_size": 2,
      "language_servers": ["vtsls", "!typescript-language-server"],
    },
    "Rust": {
      "formatter": "language_server",
      "format_on_save": "on",
      "language_servers": ["rust-analyzer"],
    },
    "Go": {
      "formatter": "language_server",
      "format_on_save": "on",
      "hard_tabs": true,
      "tab_size": 4,
      "language_servers": ["gopls"],
    },
    "Shell Script": {
      "formatter": "language_server",
      "format_on_save": "on",
      "tab_size": 2,
    },
    "Markdown": {
      "formatter": "language_server",
      "format_on_save": "on",
      "tab_size": 2,
    },
    "JSON": {
      "formatter": "language_server",
      "format_on_save": "on",
      "tab_size": 2,
    },
    "TOML": {
      "formatter": "language_server",
      "format_on_save": "on",
      "tab_size": 2,
    },
    "YAML": {
      "formatter": "language_server",
      "format_on_save": "on",
      "tab_size": 2,
    },
  },
  "file_types": {
    "Shell Script": [".env.*"],
  },

  // ⚙️ System and privacy
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "auto_update": true,
  "confirm_quit": false,
  "close_on_file_delete": false,
  "restore_on_startup": "last_workspace",
  "session": {
    "restore_unsaved_buffers": true,
    "trust_all_worktrees": false,
  },
}
